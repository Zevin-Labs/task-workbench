{
  "name": "dsh-task-workbench",
  "version": "0.6.1",
  "description": "Local-first task workbench for DeepSeek Harness: today/week/all-task views, single-day and multi-day tasks with optional times, an idea pool, and daily/weekly/monthly reviews that agents can read but never write. · 任务工作台 + 想法池 + 复盘（日/周/月），人与 AI 共用同一套写网关。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/core/*.js",
    "lib/host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:task": "node --test tests/core.test.mjs tests/service.test.mjs tests/routes.test.mjs",
    "test:idea": "node --test tests/idea-core.test.mjs tests/idea-service.test.mjs tests/idea-routes.test.mjs tests/idea-tools.test.mjs",
    "test:review": "node --test tests/review-core.test.mjs tests/review-service.test.mjs tests/review-routes.test.mjs tests/review-tools.test.mjs",
    "test:cross": "node --test tests/db.test.mjs tests/wiring.test.mjs tests/settings.test.mjs tests/skills.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "verify": "npm run check && npm test",
    "pack:check": "npm pack --dry-run --json | node scripts/verify-pack.mjs",
    "pack": "npm pack",
    "release": "bash scripts/release.sh"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "task-management",
    "todo",
    "productivity",
    "sqlite",
    "review"
  ],
  "author": "Zevin <zhuzw1990@Outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zevin-Labs/task-workbench.git"
  },
  "homepage": "https://github.com/Zevin-Labs/task-workbench#readme",
  "bugs": {
    "url": "https://github.com/Zevin-Labs/task-workbench/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
